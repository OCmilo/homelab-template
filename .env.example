# Copy to .env and adjust. Never commit .env itself.
#
# This file is the only one you edit. Which services run, where they live, and
# what they are called are all decided here; docker-compose.yml, the Caddyfile
# and jobs/jobs.json read it and should not need changes.

# --- Modules ---
# The stack is a menu. List the modules you want; everything else stays
# stopped, and its scheduled jobs are never installed. Caddy, Homepage and
# Healthchecks are always on.
#
#   downloads    gluetun tunnel + qBittorrent, Prowlarr, FlareSolverr
#   video        Jellyfin, Sonarr, Radarr, Bazarr, Jellyseerr, Maintainerr,
#                Recyclarr (pulls in downloads)
#   books        Shelfmark, Calibre-Web Automated, Audiobookshelf (pulls in
#                downloads)
#   documents    Paperless-ngx + its Redis broker
#   bookmarks    Karakeep + Meilisearch + headless Chrome
#   wiki         CouchDB sync backend for Obsidian, and the wiki agent jobs
#   finance      Firefly III, the data importer, Ghostfolio
#   monitoring   Beszel, Uptime Kuma, Dozzle, Diun
#
# Three modules need a credential or file that cannot exist until something
# else is already running, so they are opt-in separately:
#
#   decluttarr   requires video; needs config/decluttarr/config.yaml with
#                Sonarr/Radarr API keys, which exist only after those
#                services' first run
#   ibkr         needs an IBKR Flex query plus config/ghostfolio/mapping.yaml
#                mapping your own holdings; pulls in Ghostfolio
#   wiki-bridge  needs config/livesync-bridge/config.json with CouchDB
#                credentials, and a source clone in cache/build/
COMPOSE_PROFILES=video,books,documents,bookmarks,wiki,finance,monitoring

# Drives container clocks, cron interpretation for every scheduled job, and the
# Healthchecks profile timezone.
TZ=Europe/Madrid

# --- Stack identity ---
# Subdomain label all services live under: https://<service>.${STACK_HOST}.${PRIVATE_DOMAIN}
STACK_HOST=homelab
# Human-readable stack name (Healthchecks site title, dashboards).
# Quote it if it contains spaces: shell scripts source this file.
STACK_NAME=Homelab
# This machine's LAN and Tailscale IPs (used in service allowed-hosts lists)
LAN_IP=192.168.1.10
TAILSCALE_IP=100.x.y.z

# macOS user/group that owns the media files (id -u / id -g)
PUID=501
PGID=20

# Root of media storage. Internal SSD starter path; move to external APFS disk later.
DATA_ROOT="/Users/<you>/MediaData"

# --- NordVPN (gluetun / NordLynx WireGuard) ---
# WireGuard private key. NOT shown in the Nord dashboard — derive it from a NordVPN
# access token on the server (see docs). Never commit the real key.
NORDVPN_PRIVATE_KEY="<set in .env on server>"
# gluetun exit country (name or comma list), e.g. Spain, Netherlands
VPN_COUNTRIES=Spain
# LAN subnet allowed to reach the qBittorrent WebUI through gluetun's killswitch
LAN_SUBNET=192.168.1.0/24

# --- Private HTTPS (Caddy + Porkbun DNS-01) ---
# Services use https://<service>.${STACK_HOST}.${PRIVATE_DOMAIN}. These names are
# resolved only by AdGuard/Tailscale split DNS; public DNS only receives
# temporary _acme-challenge TXT records during certificate issuance/renewal.
PRIVATE_DOMAIN="<your-domain.example>"
PORKBUN_API_KEY="<set in .env on server>"
PORKBUN_API_SECRET_KEY="<set in .env on server>"

# Healthchecks requires an email-formatted login identity. The API and per-job
# ping secrets are generated under config/healthchecks.
HEALTHCHECKS_ADMIN_EMAIL=admin@example.com
# Django signing key. REQUIRED, and nothing fails if you skip it: Django
# accepts the placeholder and starts normally. Sessions and password-reset
# links are signed with this, so anyone who knows the value can forge an
# administrator login — and the placeholder is public. Changing it later
# invalidates sessions and password-reset links; passwords and checks survive.
HEALTHCHECKS_SECRET_KEY="<generate: openssl rand -base64 48>"

# --- Backups (restic) ---
# Encryption password for the restic repo on iCloud Drive. Generate once,
# keep a copy in a password manager OFF this machine.
RESTIC_PASSWORD="<set in .env on server>"
# Optional encrypted Backblaze B2 mirror. Use the S3-compatible endpoint and a
# private bucket, e.g.
# s3:https://s3.eu-central-003.backblazeb2.com/<bucket-name>/restic-repo
# The B2 repository is also a restic repo encrypted with RESTIC_PASSWORD.
RESTIC_B2_REPOSITORY=
RESTIC_B2_AWS_ACCESS_KEY_ID=
RESTIC_B2_AWS_SECRET_ACCESS_KEY=
RESTIC_B2_AWS_DEFAULT_REGION=
# Backblaze retention is intentionally tighter than iCloud by default.
RESTIC_B2_KEEP_LAST=8

# --- Telegram notifications ---
# One server-wide bot posting into a Telegram forum group; chat id is the
# -100... supergroup id. Create a topic per subsystem and put its thread id in
# the matching variable below — a forum group with General closed rejects
# messages sent without a message_thread_id.
TELEGRAM_BOT_TOKEN="<set in .env on server>"
TELEGRAM_CHAT_ID="<set in .env on server>"
# Forum topic thread ids. Leave unset to post to the group's General topic
# (thread 1); set them if General is closed, as it is in a forum group.
TELEGRAM_TOPIC_TRIVY=
TELEGRAM_TOPIC_DIUN=
TELEGRAM_TOPIC_BACKUP=
# Infrastructure/system notifications (template drift and similar)
TELEGRAM_TOPIC_SYSTEM=

# --- Vulnerability scanning (Trivy) ---
# Optional overrides — scripts/trivy-scan.sh carries these same defaults.
# Manual one-off runs override from the environment, e.g.
# TRIVY_NOTIFY=false scripts/trivy-scan.sh.
TRIVY_IMAGE=aquasec/trivy:0.72.0
TRIVY_SEVERITY=CRITICAL
TRIVY_IGNORE_UNFIXED=true
TRIVY_TIMEOUT=20m
TRIVY_NOTIFY=true

# --- Subtitle fallback translation ---
# Target languages for scripts/subtitle-translate-fallback.py, comma separated.
# Codes must have an entry in that script's TAG map.
#SUBTRANS_LANGS=es,pb
# Days a file must lack a subtitle before machine translation kicks in.
#SUBTRANS_GRACE_DAYS=5

# --- Paperless-ngx ---
# Django secret (openssl rand -hex 32) and first-run superuser credentials.
PAPERLESS_SECRET_KEY="<set in .env on server>"
PAPERLESS_ADMIN_USER="<set in .env on server>"
PAPERLESS_ADMIN_PASSWORD="<set in .env on server>"
# Broker password (openssl rand -hex 24). Redis authenticates nobody by
# default, so without this any container on the stack network could issue
# commands to the broker. Keep it hex/alphanumeric: it is interpolated into a
# redis:// URL, where reserved characters would need percent-encoding.
PAPERLESS_REDIS_PASSWORD="<set in .env on server>"
# OCR languages, as Tesseract codes. PAPERLESS_OCR_LANGUAGE is the '+'-joined
# set tried per document; PAPERLESS_OCR_LANGUAGES is the space-separated list
# of extra packs to install at startup (eng ships in the image).
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=

# --- Finance: Firefly III + data importer (docs/finance-stack.md) ---
# Laravel encryption key, EXACTLY 32 chars. Losing it makes the db unreadable;
# keep a copy in a password manager: LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 32
FIREFLY_APP_KEY="<set in .env on server>"
# Token for Firefly's own scheduled housekeeping endpoint, 32 chars (same generator)
FIREFLY_CRON_TOKEN="<set in .env on server>"
# Personal Access Token for the importer: Firefly UI → Options → Profile → OAuth
FIREFLY_ACCESS_TOKEN="<set in .env on server>"
# Secret gating the importer's /autoimport endpoint, 16+ chars (same generator)
FIREFLY_AUTO_IMPORT_SECRET="<set in .env on server>"
# Enable Banking (PSD2, free for personal use): enablebanking.com Control Panel
# → create Production application → app id + PEM private key. GoCardless Bank
# Account Data closed to new signups (2025-07), hence the provider switch.
# The key is a container PATH: the PEM lives (gitignored, chmod 600) at
# config/firefly-importer/secrets/eb-private.pem; that directory is mounted
# read-only at /secrets, and the stack starts fine before the key exists.
# Banks commonly cap consents at 90 days.
ENABLE_BANKING_APP_ID="<set in .env on server>"
ENABLE_BANKING_PRIVATE_KEY=/secrets/eb-private.pem
# Enable Banking consent expiry (YYYY-MM-DD); eb-consent-reminder.sh warns via Telegram
EB_CONSENT_EXPIRES="<date of last consent + 90 days>"
# Your bank's name and the filename of its saved importer configuration under
# config/firefly-importer/import/. Both only appear in the renewal instructions
# eb-consent-reminder.sh sends you, so they exist to keep that runbook accurate.
BANK_NAME="<your bank>"
BANK_IMPORT_CONFIG=bank.json
# Forum topic thread id for finance notifications
TELEGRAM_TOPIC_FINANCE=

# --- Finance: Ghostfolio (docs/finance-stack.md Phase 3) ---
# All four: LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 32
GHOSTFOLIO_DB_PASSWORD="<set in .env on server>"
GHOSTFOLIO_REDIS_PASSWORD="<set in .env on server>"
GHOSTFOLIO_ACCESS_TOKEN_SALT="<set in .env on server>"
GHOSTFOLIO_JWT_SECRET="<set in .env on server>"
# Ghostfolio login security token (shown once at user creation; also kept in
# config/ghostfolio/SECURITY_TOKEN) — the IBKR sync authenticates with it
GHOSTFOLIO_SECURITY_TOKEN="<set in .env on server>"
# Reporting currency for the IBKR sync (ISO 4217).
GHOSTFOLIO_CURRENCY=EUR
# IBKR Flex Web Service: Performance & Reports -> Flex Queries -> gear icon.
# Token expires yearly; note the date and renew before it lapses
IBKR_FLEX_TOKEN="<set in .env on server>"
IBKR_FLEX_QUERY_ID="<set in .env on server>"
IBKR_ACCOUNT_ID="<U... account number>"
# Optional: retry initial "statement not available" responses for up to 30 minutes.
IBKR_FLEX_MAX_TRIES=60
IBKR_FLEX_RETRY_DELAY_SECONDS=30
# Cash accounts mirrored from Firefly into Ghostfolio by
# scripts/ghostfolio-cash-sync.py: Firefly account id -> Ghostfolio account
# name. Wrap it in SINGLE quotes — the shell scripts source this file, and the
# JSON's own double quotes would end the string. Each account keeps the
# currency Firefly holds it in.
#GHOSTFOLIO_ACCOUNT_MAP='{"12": "Checking", "13": "Savings"}'

# --- Karakeep (bookmarks) ---
# NextAuth session secret and Meilisearch master key: openssl rand -hex 32
KARAKEEP_NEXTAUTH_SECRET=
KARAKEEP_MEILI_MASTER_KEY=
# OpenAI key for AI tagging (also the wiki scripts' fallback key)
KARAKEEP_OPENAI_API_KEY=

# --- Wiki: CouchDB (obsidian-livesync backend) ---
# docs/wiki-system.md. Password: openssl rand -hex 24
COUCHDB_USER=admin
COUCHDB_PASSWORD="<set in .env on server>"
# Optional: vault location and its bare git dir. Defaults are the paths the
# livesync-bridge container mirrors into.
#WIKI_VAULT="/Users/<you>/homelab/config/wiki-vault"
#WIKI_VAULT_GIT="/Users/<you>/homelab/config/wiki-vault.git"
# Optional: CouchDB base URL used by scripts/wiki-plugin-publish.py
#WIKI_COUCHDB_URL=http://127.0.0.1:5984
# Optional: donor Customization Sync profile id when first publishing a renamed
# plugin (the new id has no profile document yet).
#WIKI_TEMPLATE_PLUGIN_ID=
# Optional: delete every *.canvas under wiki/mocs on each graph-settings run.
# Off by default — it unlinks files from disk, not just from the vault's git
# history, so hand-made canvas boards there would not survive.
#WIKI_PRUNE_CANVAS=false
# Optional: seconds the enrich/ingest jobs wait for LiveSync to settle before
# reading the vault (default 180).
#WIKI_SETTLE=180
# Optional: swap the agent CLI. Default runner is codex, the only one whose
# flags are known to scripts/wiki-agent.sh. Any other value requires
# WIKI_AGENT_CMD, which receives the composed prompt on stdin and runs with the
# vault as its working directory (it owns model choice and sandboxing).
#WIKI_AGENT_RUNNER=codex
#WIKI_AGENT_CMD=
# Karakeep Settings -> API Keys; used by scripts/wiki-karakeep-pull.sh (hourly
# launchd). Bookmarks tagged `wiki` are pulled once and marked `wiki-synced`.
KARAKEEP_API_TOKEN="<set in .env on server>"
# Optional override: wiki scripts use WIKI_OPENAI_API_KEY if set, else fall
# back to KARAKEEP_OPENAI_API_KEY.
#WIKI_OPENAI_API_KEY=
# Optional model overrides for the agent (defaults in scripts/wiki-agent.sh)
#WIKI_MODEL_ENRICH=gpt-5.4-nano
#WIKI_MODEL_SYNTH=gpt-5.4-mini
#WIKI_MODEL_LINT=gpt-5.1
# Organization Admin key for the read-only OpenAI Costs API used by `$ Ops`.
# Create it at platform.openai.com/settings/organization/admin-keys. It stays on
# this host and is never returned to Obsidian. A normal project API key cannot
# access organization costs.
OPENAI_ADMIN_KEY=
# Optional: restrict Costs API totals to one OpenAI project ID. When omitted,
# Ops reports organization-wide spend.
WIKI_OPENAI_COST_PROJECT_ID=
# Shared secret for scripts/wiki-ask-server.py. Required — the server refuses
# to start without it, on loopback as much as anywhere else. Every route except
# /health requires `Authorization: Bearer <token>`; put the same value in the
# vault's system/schema/ask.json as "token" so the dashboard plugin can
# authenticate. Left empty on purpose: a shipped placeholder would be a known
# credential. Generate with: openssl rand -hex 32
WIKI_ASK_TOKEN=
# Bind address for the ask server. Loopback by default; widen it to reach the
# server from other devices (phone, laptop) over the LAN or tailnet.
#WIKI_ASK_HOST=127.0.0.1
# --- Beszel monitoring ---
# First hub user. Change in the Beszel UI after first login if desired.
BESZEL_USER_EMAIL=admin@home.arpa
BESZEL_USER_PASSWORD="<set in .env on server>"
