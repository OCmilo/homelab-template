<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.subtitle-translate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>@@HOME@@/homelab/scripts/subtitle-translate-fallback.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@@HOME@@/homelab/config/subtitle-translate.log</string>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/homelab/config/subtitle-translate.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
