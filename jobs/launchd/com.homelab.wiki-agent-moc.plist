<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.wiki-agent-moc</string>
    <key>EnvironmentVariables</key>
  <dict>
    <key>HOMELAB</key>
    <string>@@HOME@@/homelab</string>
  </dict>
  <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@@HOME@@/homelab/scripts/wiki-agent.sh</string>
        <string>refresh-moc</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/homelab/config/wiki-agent-launchd.log</string>
</dict>
</plist>
