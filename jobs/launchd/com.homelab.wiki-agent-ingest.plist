<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.wiki-agent-ingest</string>
    <key>EnvironmentVariables</key>
  <dict>
    <key>HOMELAB</key>
    <string>@@HOME@@/homelab</string>
  </dict>
  <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@@HOME@@/homelab/scripts/wiki-agent.sh</string>
        <string>ingest-inbox</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>@@HOME@@/homelab/config/wiki-vault/inbox</string>
    </array>
    <key>StartInterval</key>
    <integer>43200</integer>
    <key>ThrottleInterval</key>
    <integer>600</integer>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/homelab/config/wiki-agent-launchd.log</string>
</dict>
</plist>
